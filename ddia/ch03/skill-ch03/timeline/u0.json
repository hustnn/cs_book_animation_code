{
  "unit": "u0",
  "total": 57.064,
  "pad": 0.35,
  "beats": [
    {
      "id": "b1",
      "start": 0.0,
      "dur": 2.702,
      "speech": 2.352,
      "file": "b1.wav",
      "text": "存进去的东西，怎么才能找得回来？"
    },
    {
      "id": "b2",
      "start": 2.702,
      "dur": 5.27,
      "speech": 4.92,
      "file": "b2.wav",
      "text": "有句德国谚语说，东西收拾得井井有条，只是因为你懒得去找。"
    },
    {
      "id": "b3",
      "start": 7.972,
      "dur": 6.11,
      "speech": 5.76,
      "file": "b3.wav",
      "text": "数据库最根本要做两件事：给它数据，它存下来；再问它，它把数据还给你。"
    },
    {
      "id": "b4",
      "start": 14.082,
      "dur": 5.87,
      "speech": 5.52,
      "file": "b4.wav",
      "text": "开发者给数据、提问题；数据库这边要解决的，是怎么存、怎么找。"
    },
    {
      "id": "b5",
      "start": 19.952,
      "dur": 4.478,
      "speech": 4.128,
      "file": "b5.wav",
      "text": "排法决定找的速度：数据怎么排，问的时候就找得多快。"
    },
    {
      "id": "b6",
      "start": 24.43,
      "dur": 5.102,
      "speech": 4.752,
      "file": "b6.wav",
      "text": "本章先讲最常见的两大家族：日志结构，和页式存储。"
    },
    {
      "id": "b7",
      "start": 29.532,
      "dur": 5.75,
      "speech": 5.4,
      "file": "b7.wav",
      "text": "日志结构只往后追加；页式把数据切成一页一页，原地改。"
    },
    {
      "id": "b8a",
      "start": 35.282,
      "dur": 2.582,
      "speech": 2.232,
      "file": "b8a.wav",
      "text": "时间线上，页式这条路更老。"
    },
    {
      "id": "b8b",
      "start": 37.864,
      "dur": 2.798,
      "speech": 2.448,
      "file": "b8b.wav",
      "text": "一九七零年，B 树就出现了。"
    },
    {
      "id": "b9",
      "start": 40.662,
      "dur": 4.982,
      "speech": 4.632,
      "file": "b9.wav",
      "text": "日志结构的思想在上世纪九十年代成形，两千年之后越来越流行。"
    },
    {
      "id": "b10",
      "start": 45.644,
      "dur": 6.15,
      "speech": 5.8,
      "file": "b10.wav",
      "text": "前半段讲存和找；后半段讲分析用的另一套：事务和分析，用的引擎很不一样。"
    },
    {
      "id": "b11",
      "start": 51.794,
      "dur": 5.27,
      "speech": 4.92,
      "file": "b11.wav",
      "text": "排法决定找的速度，本章就讲两种排法和它们各自的代价。"
    }
  ]
}